import seaborn as sns from sklearn.model_selection import train_test_split from sklearn.preprocessing import OrdinalEncoder from sklearn.linear_model import LinearRegression, LogisticRegression from sklearn.metrics import ( mean_squared_error, mean_absolute_error, r2_score, accuracy_score, precision_score, recall_score, f1_score, confusion_matrix, classification_report ) 
 
2. Add the Diamonds Prices Dataset to your Kaggle notebook and do some basic cleaning steps. We will also create a binary column called ideal_cut for our logistic regression task. df = pd.read_csv('/kaggle/input/datasets/nancyalaswad90/diamonds-prices/Diamonds Prices2022.csv', index_col=0) df = df.drop_duplicates() cut_order = ['Fair', 'Good', 'Very Good', 'Premium', 'Ideal'] color_order = ['J', 'I', 'H', 'G', 'F', 'E', 'D'] clarity_order = ['I1', 'SI2', 'SI1', 'VS2', 'VS1', 'VVS2', 'VVS1', 'IF'] df['ideal_cut'] = (df['cut'] == 'Ideal').astype(int) encoder = OrdinalEncoder(categories=[color_order, clarity_order, cut_order]) df[['color', 'clarity', 'cut']] = encoder.fit_transform(df[['color', 'clarity', 'cut']]) 
 
3. Define features and labels for the Classification Task: #We will drop cut so we don't have any data leakage and predict whether the cut is ideal or not X = df[['carat', 'color', 'clarity', 'depth', 'table','price','x','y','z']] 
